# Salin file ini menjadi `.env.local` lalu sesuaikan nilainya.
#   cp .env.example .env.local
#
# PENTING:
# - Semua variabel berawalan VITE_ akan DIBUNDEL ke browser dan bisa dilihat publik.
#   Jangan pernah menaruh secret, password database, atau API secret di sini.
# - Di Vercel, isi variabel yang sama melalui Project Settings → Environment Variables.

# Base URL REST API backend (Express), termasuk prefix versi.
# Lokal: backend Express berjalan di port 5000 (SP1-01).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Nama aplikasi yang ditampilkan di UI dan judul halaman.
VITE_APP_NAME=Difabel Jabar Connect

# OAuth Client ID Google (tipe Web application) — tempel nilainya di sini, lalu restart dev server.
# Authorized JavaScript origins di Google Cloud Console: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=179624872486-34uen3oct2bcp35hkfi2249898kat0d2.apps.googleusercontent.com
